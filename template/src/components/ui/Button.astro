---
interface Props { href: string; variant?: 'primary' | 'secondary' | 'ghost' | 'light'; size?: 'md' | 'lg'; class?: string; }
const { href, variant = 'primary', size = 'md', class: cls = '' } = Astro.props;
const styles = {
  primary: 'bg-accent text-accent-ink hover:brightness-95 shadow-sm',
  secondary: 'bg-brand text-brand-ink hover:brightness-110',
  ghost: 'border border-current/25 text-current hover:bg-current/5',
  light: 'bg-white text-ink hover:bg-white/90',
};
const sizes = { md: 'h-11 px-5 text-[15px]', lg: 'h-14 px-7 text-base' };
---
<a href={href} class:list={['inline-flex items-center justify-center gap-2 rounded-btn font-semibold transition', styles[variant], sizes[size], cls]}>
  <slot />
</a>
